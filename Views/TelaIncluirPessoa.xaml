<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appClassePessoaBD.Views.TelaIncluirPessoa"
             Title="Incluir Pessoa">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label Text="Cadastrar Nova Pessoa" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <Entry x:Name="txtNome" Placeholder="Digite o Nome" />
            <Entry x:Name="txtIdade" Placeholder="Digite a Idade" Keyboard="Numeric" />
            <Entry x:Name="txtEmail" Placeholder="Digite o E-mail" Keyboard="Email" />

            <Button Text="Salvar Registro" Clicked="OnSalvarClicked" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>